# =====================
# 构建目录（非常重要）
# =====================
build/
out/
cmake-build-*/

# =====================
# CMake 缓存与临时文件
# =====================
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
install_manifest.txt

# =====================
# VS Code
# =====================
.vscode/settings.json
.vscode/launch.json
.vscode/c_cpp_properties.json
*.code-workspace

# 可选：保留统一配置模板
# !.vscode/settings.json

# =====================
# CLion / 其他 IDE
# =====================
.idea/
*.iml

# =====================
# 编译产物
# =====================
*.o
*.a
*.so
*.exe
*.out
*.dll
*.dylib

# =====================
# 调试与日志
# =====================
*.log
core
core.*

# =====================
# 系统文件
# =====================
.DS_Store
Thumbs.db

# =====================
# 依赖（如 conan / vcpkg）
# =====================
vcpkg_installed/
conan_build/

tmp/
